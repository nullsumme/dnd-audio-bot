{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "The bot is a stateful Discord singleton and must run exactly one replica."
    },
    "discord": {
      "type": "object",
      "required": ["existingSecret", "tokenKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "tokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "opusBitrateMode",
        "maxUploadBytes",
        "maxArtworkBytes",
        "maxLibraryBytes",
        "minFreeBytes",
        "maxConcurrentUploads",
        "maxPcmCacheBytes",
        "maxPcmCacheEntryBytes"
      ],
      "properties": {
        "opusBitrateMode": {
          "type": "string",
          "enum": ["auto", "64000", "96000", "128000"]
        },
        "maxUploadBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "maxArtworkBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "maxLibraryBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "minFreeBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "maxConcurrentUploads": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxPcmCacheBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "maxPcmCacheEntryBytes": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["maxEntries"],
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessModes", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "size": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": ["replicaCount", "discord", "audio", "activity", "persistence"]
}
